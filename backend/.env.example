GEMINI_API_KEY=your_google_ai_studio_key
# Strongly recommended — fixes "Failed to find issues" from GitHub rate limits:
GITHUB_TOKEN=your_github_personal_access_token
# Optional:
# GEMINI_MODEL=gemini-2.5-flash
# Extra CORS origins (production is already allowed in main.py):
# ALLOWED_ORIGINS=https://open-source-code-navigator.vercel.app
